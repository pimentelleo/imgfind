<Window x:Class="ImgFind.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ImgFind — localizar e organizar imagens" Height="720" Width="1100"
        MinHeight="560" MinWidth="800" WindowStartupLocation="CenterScreen" Closing="Window_Closing">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="ImgFind" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock Text="Encontre imagens em uma pasta e em suas subpastas." Margin="0,2,0,12"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Origem:" VerticalAlignment="Center" Width="70"/>
                <TextBox x:Name="SourcePath" Grid.Column="1" IsReadOnly="True" Padding="6" VerticalContentAlignment="Center"/>
                <Button x:Name="BrowseSource" Grid.Column="2" Content="Escolher pasta..." Margin="8,0,0,0" Padding="12,6" Click="BrowseSource_Click"/>
            </Grid>
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Destino:" VerticalAlignment="Center" Width="70"/>
                <TextBox x:Name="DestinationPath" Grid.Column="1" IsReadOnly="True" Padding="6" VerticalContentAlignment="Center"/>
                <Button x:Name="BrowseDestination" Grid.Column="2" Content="Escolher pasta..." Margin="8,0,0,0" Padding="12,6" Click="BrowseDestination_Click"/>
            </Grid>
        </StackPanel>
        <DockPanel Grid.Row="1" Margin="0,14,0,8">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="SelectAllButton" Content="Selecionar todas" Padding="10,5" Click="SelectAll_Click"/>
                <Button x:Name="ClearButton" Content="Limpar seleção" Margin="6,0,0,0" Padding="10,5" Click="ClearSelection_Click"/>
            </StackPanel>
            <Button x:Name="ScanButton" Content="Varrer imagens" Padding="12,5" HorizontalAlignment="Left" Click="Scan_Click"/>
        </DockPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
            <ListBox x:Name="ImageList" ItemsSource="{Binding Images}" SelectionChanged="ImageList_SelectionChanged"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="3">
                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0"
                                      ToolTip="Incluir na movimentação"/>
                            <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border Grid.Column="2" BorderBrush="#CCCCCC" BorderThickness="1" Padding="10">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Image x:Name="Preview" Stretch="Uniform"/>
                    <TextBlock x:Name="PreviewText" Grid.Row="1" Text="Selecione um arquivo para visualizar." TextWrapping="Wrap" Margin="0,8,0,0"/>
                </Grid>
            </Border>
        </Grid>
        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <Button x:Name="MoveAllButton" DockPanel.Dock="Right" Content="Mover todas" Padding="12,8" Margin="8,0,0,0" Click="MoveAll_Click"/>
            <Button x:Name="MoveSelectedButton" DockPanel.Dock="Right" Content="Mover selecionadas" Padding="12,8" Margin="8,0,0,0" Click="MoveSelected_Click"/>
            <TextBlock x:Name="Status" VerticalAlignment="Center" TextWrapping="Wrap" Text="Escolha uma pasta de origem."/>
        </DockPanel>
    </Grid>
</Window>
