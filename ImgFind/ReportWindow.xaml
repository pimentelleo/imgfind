<Window x:Class="ImgFind.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="850" Height="500" MinWidth="500" MinHeight="300" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <TextBlock x:Name="Summary" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <Button DockPanel.Dock="Bottom" Content="Fechar" HorizontalAlignment="Right" Padding="18,7" Margin="0,12,0,0" IsCancel="True"/>
        <TextBox x:Name="Details" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True"/>
    </DockPanel>
</Window>
