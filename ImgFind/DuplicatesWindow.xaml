<Window x:Class="ImgFind.DuplicatesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Duplicatas por conteúdo" Width="850" Height="550" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="Arquivos em cada grupo têm o mesmo conteúdo. Deseja deixar as cópias duplicadas fora desta movimentação? Nenhum arquivo será excluído. Se já houver uma cópia no destino, nenhuma cópia desse grupo será movida; caso contrário, uma será movida."/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancelar" Padding="12,7" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Mover também as duplicatas" Padding="12,7" Margin="0,0,8,0" Click="Keep_Click"/>
            <Button Content="Não mover duplicatas" Padding="12,7" Click="Exclude_Click" IsDefault="True"/>
        </StackPanel>
        <TextBox x:Name="Details" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True"/>
    </DockPanel>
</Window>
