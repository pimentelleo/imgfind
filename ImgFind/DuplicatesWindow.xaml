<Window x:Class="ImgFind.DuplicatesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revisar duplicatas — ImgFind" Width="850" Height="600" MinWidth="700" MinHeight="480"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="ANTES DE MOVER" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
            <TextBlock Text="Encontramos imagens duplicadas" FontSize="23" FontWeight="Bold" Margin="0,6,0,0"/>
            <TextBlock Text="Arquivos em cada grupo têm o mesmo conteúdo, mesmo que os nomes sejam diferentes."
                       Foreground="{StaticResource Muted}" Margin="0,7,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <Border Grid.Row="1" Background="#F0EEFF" CornerRadius="10" Padding="14,12" Margin="0,18,0,14">
            <TextBlock TextWrapping="Wrap" Foreground="#4D45A2">
                <Run FontWeight="Bold" Text="Seus arquivos estão seguros. "/>
                <Run Text="Ao não mover duplicatas, uma cópia por grupo é movida. Se já houver uma no destino, nenhuma cópia do grupo será movida. Os demais arquivos permanecem onde estão; nada é excluído."/>
            </TextBlock>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14">
            <TextBox x:Name="Details" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     AcceptsReturn="True" BorderThickness="0" Background="Transparent" Foreground="{StaticResource Ink}"/>
        </Border>
        <Grid Grid.Row="3" Margin="0,18,0,0">
            <Button Content="Cancelar" HorizontalAlignment="Left" Click="Cancel_Click" IsCancel="True"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Mover também as duplicatas" Click="Keep_Click" Margin="0,0,8,0"/>
                <Button Content="Não mover duplicatas" Style="{StaticResource PrimaryButton}" Click="Exclude_Click" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
