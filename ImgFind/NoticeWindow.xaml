<Window x:Class="ImgFind.NoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ImgFind" Width="520" SizeToContent="Height" MinHeight="230" MaxHeight="600"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="Eyebrow" Text="IMGFIND" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
            <TextBlock x:Name="Heading" FontSize="22" FontWeight="Bold" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="330" Margin="0,12,0,20">
            <TextBlock x:Name="Message" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="13"/>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="Cancelar" Margin="0,0,8,0" Click="Cancel_Click" IsCancel="True"/>
            <Button x:Name="AcceptButton" Content="Entendi" Click="Accept_Click" Style="{StaticResource PrimaryButton}" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
